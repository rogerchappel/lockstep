{
  "name": "lockstep",
  "version": "0.1.0",
  "description": "Multi-package script and toolchain drift checker.",
  "type": "module",
  "bin": {
    "lockstep": "./dist/src/cli.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "docs",
    "SAFETY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "smoke": "npm run build && node dist/src/cli.js scan tests/fixtures/workspace --policy tests/fixtures/workspace/lockstep.config.json --format markdown --output /tmp/lockstep-smoke.md && test -s /tmp/lockstep-smoke.md",
    "package:smoke": "npm pack --dry-run",
    "release:check": "npm test && npm run check && npm run build && npm run smoke && npm run package:smoke"
  },
  "keywords": [
    "cli",
    "tooling",
    "monorepo",
    "drift",
    "package-json",
    "local-first"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/lockstep.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/lockstep/issues"
  },
  "homepage": "https://github.com/rogerchappel/lockstep#readme",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
